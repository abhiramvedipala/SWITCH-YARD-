{
  "name": "switchyard",
  "private": true,
  "version": "0.0.1",
  "description": "Local-first desktop workspace for running coding agents side by side.",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build -w @switchyard/web && npm run build -w @switchyard/bus-mcp && npm run build -w @switchyard/core",
    "start": "npm run build && npm run start -w @switchyard/core",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "npm run test:e2e -w @switchyard/core --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test:ui": "npm run build && node scripts/ui-check.mjs",
    "stop": "node scripts/stop.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^17.13.0",
    "playwright-core": "^1.64.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0"
  }
}
